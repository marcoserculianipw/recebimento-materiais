# CONFIGURAÇÃO NECESSÁRIA - MICROSOFT 365 & ENTRA ID
# Preencha estas variáveis após criar o App Registration no Portal do Azure (Entra ID)

PORT=5000

# 1. Credenciais do Microsoft Entra ID (Azure AD)
AZURE_TENANT_ID=seu-tenant-id-aqui
AZURE_CLIENT_ID=seu-client-id-aqui
AZURE_CLIENT_SECRET=seu-client-secret-aqui

# 2. Configurações do SharePoint e Microsoft Lists
# ID do Site do SharePoint (ex: "intercarta.sharepoint.com,guid-site,guid-web" ou caminho)
SHAREPOINT_SITE_ID=seu-site-id-sharepoint
# Nome da lista criada para os recebimentos
SHAREPOINT_LIST_NAME=APP_RECEBIMENTO

# 3. Biblioteca de Documentos para fotos no SharePoint (Drive ID ou Nome)
SHAREPOINT_DRIVE_NAME=Documentos Compartilhados
SHAREPOINT_PHOTOS_FOLDER=RecebimentoFotos
